rules_version = '2';

// One document per person at users/{uid}, readable and writable only by that
// signed-in person (ADR 0001). From version 2 every setting, Occasion and
// Earn Date edit is its own field, so each device writes only the entries it
// changed (ADR 0003). Everything else is denied, including listing the users
// collection, which a `get`-style match on one id never allows.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow get, delete: if isOwner(uid);
      // Only this version's shape is created, so an app older than version 2,
      // still open in a tab, can't recreate data deleted elsewhere.
      allow create: if isOwner(uid) && isUserDocument(request.resource.data)
        && request.resource.data.version >= 2;
      // The version never goes down, so an app older than the document can't
      // overwrite it in a shape it doesn't understand.
      allow update: if isOwner(uid) && isUserDocument(request.resource.data)
        && request.resource.data.version >= resource.data.get('version', 0);
    }
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  function isUserDocument(d) {
    return d.keys().hasOnly(['version', 'data', 'updatedAt'])
      && d.version is int && d.version >= 1
      && d.data is map
      && d.data.keys().hasOnly(['settings', 'occasions', 'occasionsById', 'earnDateEdits'])
      && (!('updatedAt' in d) || d.updatedAt is timestamp)
      && (d.version == 1 || isVersion2Data(d.data));
  }

  // Version 2 on. A document may hold only some parts (a new one starts with
  // the entries its first edit wrote), but each part has its own shape:
  // `occasions` is version 1's list, kept as it was.
  function isVersion2Data(data) {
    return (!('settings' in data) || isSettings(data.settings))
      && (!('earnDateEdits' in data) || data.earnDateEdits is map)
      && (!('occasionsById' in data) || data.occasionsById is map)
      && (!('occasions' in data) || data.occasions is list);
  }

  function isSettings(s) {
    return s is map && s.keys().hasOnly([
      'hireDate', 'weeklyHours', 'regularDaysOff', 'sapVacationHours',
      'sapFloatingHolidayHours', 'sapAsOf', 'fullYearHistory'
    ]);
  }
}
