# Firebase web config for sign-in and sync. Copy to .env.local and fill in.
# Without these the app runs signed-out only and hides the sign-in button.
#
# These values are public by design (they end up in the built JavaScript),
# but they stay out of the repo. Security comes from firestore.rules.
#
# VITE_FIREBASE_AUTH_DOMAIN must be the domain that serves the app, for
# example <project-id>.web.app, not <project-id>.firebaseapp.com. Safari
# partitions third-party storage, and redirect sign-in only works there
# when the auth handler is on the same domain as the app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local only: set to true, with VITE_FIREBASE_PROJECT_ID=demo-time-off-tracker
# and any placeholder values above, to sign in against `npm run emulators`.
# Only `npm run dev` on a demo- project honours it, and `npm run deploy`
# refuses to run while it's set.
# VITE_FIREBASE_USE_EMULATORS=true
